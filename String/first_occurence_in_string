class Solution {

public:

    int lengthOfLastWord(string s) {

        

        int max_count = 0;

        string max_str = "" ;

        

        for(int i=0; i<s.size(); i++){

            string current_str = "" ;

            int current_count = 0;



            while(i < s.length() && s[i] != ' ')

            {

                current_str += s[i] ;

                current_count++ ;

                

            }

             

             if(current_count > max_count){

                    max_str = current_str ;

                }

        } return max_str ;

    }

};